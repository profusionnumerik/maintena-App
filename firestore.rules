rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isSignedIn() && request.auth.token.superAdmin == true;
    }

    function isMember(coProId) {
      return isSignedIn() && exists(/databases/$(database)/documents/copros/$(coProId)/members/$(request.auth.uid));
    }

    function memberData(coProId) {
      return get(/databases/$(database)/documents/copros/$(coProId)/members/$(request.auth.uid)).data;
    }

    function isCoProAdmin(coProId) {
      return isMember(coProId) && memberData(coProId).role == 'admin';
    }

    function isConseilMember(coProId) {
      return isMember(coProId) && memberData(coProId).role == 'conseil';
    }

    function canManageFinances(coProId) {
      return isSignedIn() && (isCoProAdmin(coProId) || isConseilMember(coProId));
    }

    function canReadCopro(coProId) {
      return isSuperAdmin() || isMember(coProId) || (isSignedIn() && resource.data.adminId == request.auth.uid);
    }

    match /users/{uid} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
    }

    match /accountDeletionRequests/{requestId} {
      allow create: if true;
      allow read, update, delete: if isSuperAdmin();
    }

    // Index d'unicité des numéros de téléphone (vérifié avant/après inscription)
    match /phoneIndex/{phone} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Prestataires en attente d'inscription (écrits par le serveur Admin SDK)
    match /pendingProviders/{phone} {
      allow read, delete: if isSignedIn();
      allow write: if isSuperAdmin();
    }

    match /inviteCodes/{code} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.coProId is string;
      allow update, delete: if isSignedIn() && (isSuperAdmin() || isCoProAdmin(resource.data.coProId));
    }

    match /guestInterventionInvites/{inviteId} {
      allow read, write: if false;
    }

    match /copros/{coProId} {
      allow read: if canReadCopro(coProId);
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (
        isSuperAdmin() ||
        isCoProAdmin(coProId) ||
        // Membres du conseil : uniquement les champs du vote trésorier
        (isConseilMember(coProId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['conseilVote', 'tresorierUid']))
      );

      match /members/{userId} {
        allow read: if isSignedIn() && (isSuperAdmin() || isMember(coProId));
        allow write: if isSignedIn() && (isSuperAdmin() || isCoProAdmin(coProId) || request.auth.uid == userId);
      }

      match /interventions/{interventionId} {
        allow read: if isSignedIn() && isMember(coProId);
        allow create: if isSignedIn() && isMember(coProId) && memberData(coProId).role in ['admin', 'collaborateur'];
        allow update: if isSignedIn() && isMember(coProId) && (
          memberData(coProId).role != 'propriétaire' ||
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rating'])
        );
        allow delete: if isSignedIn() && (isCoProAdmin(coProId) || isSuperAdmin());
      }

      match /providerContacts/{contactId} {
        allow read: if isSignedIn() && isMember(coProId);
        allow create, update, delete: if isSignedIn() && isCoProAdmin(coProId);
      }

      match /expenses/{expenseId} {
        allow read: if canManageFinances(coProId);
        allow create, update: if canManageFinances(coProId);
        allow delete: if isSignedIn() && isCoProAdmin(coProId);
      }

      match /budgets/{budgetId} {
        allow read: if canManageFinances(coProId);
        allow write: if canManageFinances(coProId);
      }

      match /signalements/{signalementId} {
        allow create, read: if isSignedIn() && isMember(coProId);
        allow update, delete: if isSignedIn() && (isCoProAdmin(coProId) || isSuperAdmin());
      }

      match /announcements/{announcementId} {
        allow read: if isSignedIn() && isMember(coProId);
        allow create: if isSignedIn() && isCoProAdmin(coProId);
        allow update, delete: if isSignedIn() && (isCoProAdmin(coProId) || isSuperAdmin());
      }
    }

    match /{path=**}/members/{memberId} {
      allow read: if isSignedIn();
    }
  }
}
