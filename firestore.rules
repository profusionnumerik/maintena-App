rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isSignedIn() && request.auth.token.superAdmin == true;
    }

    function isMember(coProId) {
      return isSignedIn() && exists(/databases/$(database)/documents/copros/$(coProId)/members/$(request.auth.uid));
    }

    function memberData(coProId) {
      return get(/databases/$(database)/documents/copros/$(coProId)/members/$(request.auth.uid)).data;
    }

    function isCoProAdmin(coProId) {
      return isMember(coProId) && memberData(coProId).role == 'admin';
    }

    function isConseilMember(coProId) {
      return isMember(coProId) && memberData(coProId).role == 'conseil';
    }

    function canManageFinances(coProId) {
      return isSignedIn() && (isCoProAdmin(coProId) || isConseilMember(coProId));
    }

    function canReadCopro(coProId) {
      return isSuperAdmin() || isMember(coProId) || (isSignedIn() && resource.data.adminId == request.auth.uid);
    }

    /** Vérifie si l'utilisateur est locataire du logement (via rentalInfo stocké dans son profil) */
    function isTenantOf(propertyId) {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.rentalInfo.propertyId == propertyId;
    }

    match /users/{uid} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
    }

    match /accountDeletionRequests/{requestId} {
      allow create: if true;
      allow read, update, delete: if isSuperAdmin();
    }

    // Index d'unicité des numéros de téléphone (vérifié avant/après inscription)
    match /phoneIndex/{phone} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Prestataires en attente d'inscription (écrits par le serveur Admin SDK)
    match /pendingProviders/{phone} {
      allow read, delete: if isSignedIn();
      allow write: if isSuperAdmin();
    }

    match /inviteCodes/{code} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.coProId is string;
      allow update, delete: if isSignedIn() && (isSuperAdmin() || isCoProAdmin(resource.data.coProId));
    }

    match /guestInterventionInvites/{inviteId} {
      allow read, write: if false;
    }

    match /copros/{coProId} {
      allow read: if canReadCopro(coProId);
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (
        isSuperAdmin() ||
        isCoProAdmin(coProId) ||
        // Membres du conseil : uniquement les champs du vote trésorier
        (isConseilMember(coProId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['conseilVote', 'tresorierUid', 'revoteRequest']))
      );
      allow delete: if isSignedIn() && (isSuperAdmin() || resource.data.adminId == request.auth.uid);

      match /members/{userId} {
        allow read: if isSignedIn() && (isSuperAdmin() || isMember(coProId));
        allow write: if isSignedIn() && (isSuperAdmin() || isCoProAdmin(coProId) || request.auth.uid == userId);
      }

      match /interventions/{interventionId} {
        allow read: if isSignedIn() && isMember(coProId);
        allow create: if isSignedIn() && isMember(coProId) && memberData(coProId).role in ['admin', 'collaborateur'];
        allow update: if isSignedIn() && isMember(coProId) && (
          memberData(coProId).role != 'propriétaire' ||
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rating'])
        );
        allow delete: if isSignedIn() && (isCoProAdmin(coProId) || isSuperAdmin());
      }

      match /providerContacts/{contactId} {
        allow read: if isSignedIn() && isMember(coProId);
        allow create, update, delete: if isSignedIn() && isCoProAdmin(coProId);
      }

      match /expenses/{expenseId} {
        allow read: if canManageFinances(coProId);
        allow create, update: if canManageFinances(coProId);
        allow delete: if isSignedIn() && isCoProAdmin(coProId);
      }

      match /budgets/{budgetId} {
        allow read: if canManageFinances(coProId);
        allow write: if canManageFinances(coProId);
      }

      match /signalements/{signalementId} {
        allow create, read: if isSignedIn() && isMember(coProId);
        allow update, delete: if isSignedIn() && (isCoProAdmin(coProId) || isSuperAdmin());
      }

      match /announcements/{announcementId} {
        allow read: if isSignedIn() && isMember(coProId);
        allow create: if isSignedIn() && isCoProAdmin(coProId);
        allow update, delete: if isSignedIn() && (isCoProAdmin(coProId) || isSuperAdmin());
      }

      match /demandesDevis/{demandeId} {
        // Tout membre peut lire et créer un ticket
        allow read: if isSignedIn() && isMember(coProId);
        allow create: if isSignedIn() && isMember(coProId);
        // Mise à jour : admin, conseil, ou créateur du ticket
        allow update: if isSignedIn() && (
          isCoProAdmin(coProId) || isConseilMember(coProId) ||
          resource.data.createdBy == request.auth.uid
        );
        allow delete: if isSignedIn() && isCoProAdmin(coProId);
      }

      match /entretiens/{entretienId} {
        // Lecture : tous les membres de la copropriété
        allow read: if isSignedIn() && isMember(coProId);
        // Écriture : admin et conseil seulement
        allow create, update: if isSignedIn() && (isCoProAdmin(coProId) || isConseilMember(coProId));
        allow delete: if isSignedIn() && isCoProAdmin(coProId);
      }

      match /polls/{pollId} {
        // Visible à tous les membres (filtrage de visibilité assuré côté client)
        allow read: if isSignedIn() && isMember(coProId);
        // Tout membre non-prestataire peut créer un sondage
        allow create: if isSignedIn() && isMember(coProId) && memberData(coProId).role != 'prestataire';
        // Vote : le créateur ou l'admin peut clôturer/modifier ; n'importe quel membre peut voter (update votes seulement)
        allow update: if isSignedIn() && isMember(coProId) && (
          isCoProAdmin(coProId) ||
          resource.data.createdBy == request.auth.uid ||
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['votes'])
        );
        // Suppression : créateur ou admin seulement
        allow delete: if isSignedIn() && (
          isCoProAdmin(coProId) ||
          resource.data.createdBy == request.auth.uid ||
          isSuperAdmin()
        );
      }
    }

    match /{path=**}/members/{memberId} {
      allow read: if isSignedIn();
    }

    // Tokens de devis (lookup public pour le formulaire prestataire — lecture par token uniquement côté serveur Admin SDK)
    match /devisTokens/{token} {
      allow read, write: if false; // accès exclusivement via Admin SDK (Cloud Run)
    }

    // Accès démo accordés par le super admin — exclusivement via Admin SDK
    match /demoInvites/{email} {
      allow read, write: if false;
    }

    // Liens démo générés par le super admin — exclusivement via Admin SDK
    match /demoLinks/{token} {
      allow read, write: if false;
    }

    // Configuration globale de l'app (maintenance, etc.)
    match /appConfig/{docId} {
      allow read: if true;           // public — tous les clients lisent le flag maintenance
      allow write: if isSuperAdmin(); // seul le superadmin peut activer/désactiver
    }

    // ── Module Location ──────────────────────────────────────────────────────

    // Logements — bailleur propriétaire + locataire peut lire son propre logement
    match /properties/{propertyId} {
      allow read: if isSignedIn() && (
        isSuperAdmin() ||
        resource.data.landlordId == request.auth.uid ||
        isTenantOf(propertyId)
      );
      allow create: if isSignedIn() &&
        request.resource.data.landlordId == request.auth.uid;
      allow update, delete: if isSignedIn() && (
        isSuperAdmin() ||
        resource.data.landlordId == request.auth.uid
      );

      // Locataires du logement
      match /tenants/{tenantId} {
        allow read: if isSignedIn() && (
          isSuperAdmin() ||
          get(/databases/$(database)/documents/properties/$(propertyId)).data.landlordId == request.auth.uid ||
          resource.data.userId == request.auth.uid
        );
        allow create, update, delete: if isSignedIn() && (
          isSuperAdmin() ||
          get(/databases/$(database)/documents/properties/$(propertyId)).data.landlordId == request.auth.uid
        );
      }

      // Signalements locataire
      match /issues/{issueId} {
        allow read: if isSignedIn() && (
          isSuperAdmin() ||
          get(/databases/$(database)/documents/properties/$(propertyId)).data.landlordId == request.auth.uid ||
          resource.data.tenantUserId == request.auth.uid
        );
        allow create: if isSignedIn(); // locataire peut signaler un problème
        allow update, delete: if isSignedIn() && (
          isSuperAdmin() ||
          get(/databases/$(database)/documents/properties/$(propertyId)).data.landlordId == request.auth.uid
        );
      }

      // Interventions du logement
      match /interventions/{interventionId} {
        allow read: if isSignedIn() && (
          isSuperAdmin() ||
          get(/databases/$(database)/documents/properties/$(propertyId)).data.landlordId == request.auth.uid
        );
        allow create, update, delete: if isSignedIn() && (
          isSuperAdmin() ||
          get(/databases/$(database)/documents/properties/$(propertyId)).data.landlordId == request.auth.uid
        );
      }

      // Documents (bail, état des lieux, DPE…)
      // Le locataire peut lire les documents marqués visibleToTenant = true
      match /documents/{docId} {
        allow read: if isSignedIn() && (
          isSuperAdmin() ||
          get(/databases/$(database)/documents/properties/$(propertyId)).data.landlordId == request.auth.uid ||
          (isTenantOf(propertyId) && resource.data.visibleToTenant == true)
        );
        allow create, update, delete: if isSignedIn() && (
          isSuperAdmin() ||
          get(/databases/$(database)/documents/properties/$(propertyId)).data.landlordId == request.auth.uid
        );
      }

      // Quittances de loyer
      match /quittances/{quittanceId} {
        allow read, create: if isSignedIn() && (
          isSuperAdmin() ||
          get(/databases/$(database)/documents/properties/$(propertyId)).data.landlordId == request.auth.uid
        );
        allow update, delete: if isSignedIn() && (
          isSuperAdmin() ||
          get(/databases/$(database)/documents/properties/$(propertyId)).data.landlordId == request.auth.uid
        );
      }

      // Carnet d'entretien / historique du logement
      match /history/{eventId} {
        allow read, write: if isSignedIn() && (
          isSuperAdmin() ||
          get(/databases/$(database)/documents/properties/$(propertyId)).data.landlordId == request.auth.uid
        );
      }
    }

    // Professionnels — pool partagé entre les modules
    match /professionals/{professionalId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() &&
        request.resource.data.createdByUid == request.auth.uid;
      allow update, delete: if isSignedIn() && (
        isSuperAdmin() ||
        resource.data.createdByUid == request.auth.uid
      );
    }

    // Liens bailleur ↔ professionnel (carnet personnel, notes privées)
    match /professionalLinks/{linkId} {
      allow read: if isSignedIn() && resource.data.ownerUid == request.auth.uid;
      allow create: if isSignedIn() &&
        request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if isSignedIn() &&
        resource.data.ownerUid == request.auth.uid;
    }

    // Invitations locataires (lien magique) — écriture Admin SDK uniquement
    match /rentalInvitations/{token} {
      allow read: if true;   // lien magique accessible sans authentification
      allow write: if false; // Admin SDK (Cloud Run) uniquement
    }

    // ── Signalements locataire ───────────────────────────────────────────────

    match /properties/{propertyId}/tenantReports/{reportId} {
      // Locataire : peut créer + voir ses propres signalements
      allow create: if isSignedIn() && isTenantOf(propertyId) &&
        request.resource.data.tenantUserId == request.auth.uid;
      allow read: if isSignedIn() && (
        isTenantOf(propertyId) ||
        get(/databases/$(database)/documents/properties/$(propertyId)).data.landlordId == request.auth.uid
      );
      // Bailleur : lecture + mise à jour statut
      allow update: if isSignedIn() &&
        get(/databases/$(database)/documents/properties/$(propertyId)).data.landlordId == request.auth.uid;
    }

    // ── Module État des lieux ────────────────────────────────────────────────

    match /properties/{propertyId}/inventoryReports/{reportId} {
      // Bailleur : accès complet à ses logements
      allow read, write: if isSignedIn() && (
        isSuperAdmin() ||
        get(/databases/$(database)/documents/properties/$(propertyId)).data.landlordId == request.auth.uid
      );

      // Locataire : lecture si c'est son logement (tenantUserId peut être null si créé avant inscription)
      allow read: if isSignedIn() && isTenantOf(propertyId);

      // Locataire : peut mettre à jour ses observations + signature + statut (signed)
      allow update: if isSignedIn() &&
        isTenantOf(propertyId) &&
        resource.data.status in ["ready_for_signature", "partially_signed"] &&
        request.resource.data.status in ["ready_for_signature", "partially_signed", "signed"] &&
        request.resource.data.diff(resource.data)
          .affectedKeys().hasOnly(["signatures", "tenantObservations", "updatedAt", "status", "lastSharedAt"]);

      // Pièces — sous-collection du rapport
      match /rooms/{roomId} {
        // Bailleur : accès complet
        allow read, write: if isSignedIn() && (
          isSuperAdmin() ||
          get(/databases/$(database)/documents/properties/$(propertyId)).data.landlordId == request.auth.uid
        );

        // Locataire : lecture de toutes les pièces si c'est son logement
        // (tenantUserId peut être null si le rapport a été créé avant l'inscription du locataire)
        allow read: if isSignedIn() && isTenantOf(propertyId);

        allow update: if isSignedIn() &&
          isTenantOf(propertyId) &&
          get(/databases/$(database)/documents/properties/$(propertyId)/inventoryReports/$(reportId))
            .data.status in ["draft", "ready_for_signature", "partially_signed"] &&
          request.resource.data.diff(resource.data)
            .affectedKeys().hasOnly(["tenantObservation", "updatedAt"]);
      }
    }
  }
}
