rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    match /copros/{coProId}/{allPaths=**} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.resource.size < 10 * 1024 * 1024;
    }

    // Signatures personnelles (modèle + signatures devis)
    match /signatures/{uid}/{allPaths=**} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == uid
                   && request.resource.size < 1 * 1024 * 1024;
    }

    // ── Messagerie — messages audio locataire ↔ bailleur ────────────────────
    match /messages/{propertyId}/{allPaths=**} {
      // Lecture : bailleur ou locataire du logement
      allow read: if isSignedIn() && (
        firestore.get(/databases/(default)/documents/properties/$(propertyId))
          .data.landlordId == request.auth.uid ||
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid))
          .data.rentalInfo.propertyId == propertyId
      );
      // Écriture : l'un ou l'autre, max 10 Mo, audio uniquement
      allow write: if isSignedIn() && (
        firestore.get(/databases/(default)/documents/properties/$(propertyId))
          .data.landlordId == request.auth.uid ||
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid))
          .data.rentalInfo.propertyId == propertyId
      ) &&
      request.resource.size < 10 * 1024 * 1024 &&
      request.resource.contentType.matches("audio/.*");
    }

    // ── Helpers plan bailleur ────────────────────────────────────────────────
    // Plan gratuit : 5 Mo max par fichier. Plan Pro (SIRET ou société) : 20 Mo.
    function landlordIsPro() {
      let profile = firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.rentalProfile;
      return profile != null && (profile.companyType == "société" || (profile.keys().hasAll(["siret"]) && profile.siret != ""));
    }
    function maxSizeForLandlord() {
      return landlordIsPro() ? 20 * 1024 * 1024 : 5 * 1024 * 1024;
    }

    // ── Documents logement (bail, DPE, factures, photos…) ───────────────────
    match /properties/{propertyId}/documents/{allPaths=**} {
      // Lecture : bailleur ou locataire si le document est partagé
      allow read: if isSignedIn() && (
        firestore.get(/databases/(default)/documents/properties/$(propertyId))
          .data.landlordId == request.auth.uid ||
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid))
          .data.rentalInfo.propertyId == propertyId
      );
      // Écriture : bailleur uniquement, PDF ou image
      // Gratuit : 5 Mo max — Pro (SIRET/société) : 20 Mo max
      allow write: if isSignedIn() &&
        firestore.get(/databases/(default)/documents/properties/$(propertyId))
          .data.landlordId == request.auth.uid &&
        request.resource.size < maxSizeForLandlord() &&
        request.resource.contentType.matches("application/pdf|image/.*");
    }

    // ── Module État des lieux — photos pièces, compteurs, PDF ──────────────
    match /properties/{propertyId}/inventory/{allPaths=**} {
      // Lecture : bailleur du logement ou locataire du logement
      allow read: if isSignedIn() && (
        firestore.get(/databases/(default)/documents/properties/$(propertyId))
          .data.landlordId == request.auth.uid ||
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid))
          .data.rentalInfo.propertyId == propertyId
      );

      // Écriture : bailleur OU locataire, images ou PDF uniquement
      // Gratuit : 5 Mo max par fichier — Pro : 20 Mo max
      allow write: if isSignedIn() &&
        (
          firestore.get(/databases/(default)/documents/properties/$(propertyId))
            .data.landlordId == request.auth.uid ||
          firestore.get(/databases/(default)/documents/users/$(request.auth.uid))
            .data.rentalInfo.propertyId == propertyId
        ) &&
        request.resource.size < 5 * 1024 * 1024 &&
        request.resource.contentType.matches("image/.*|application/pdf");
    }
  }
}
