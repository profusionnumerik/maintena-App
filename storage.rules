rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    match /copros/{coProId}/{allPaths=**} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.resource.size < 10 * 1024 * 1024;
    }

    // Signatures personnelles (modèle + signatures devis)
    match /signatures/{uid}/{allPaths=**} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == uid
                   && request.resource.size < 1 * 1024 * 1024;
    }

    // ── Messagerie — messages audio locataire ↔ bailleur ────────────────────
    match /messages/{propertyId}/{allPaths=**} {
      // Lecture : bailleur ou locataire du logement
      allow read: if isSignedIn() && (
        firestore.get(/databases/(default)/documents/properties/$(propertyId))
          .data.landlordId == request.auth.uid ||
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid))
          .data.rentalInfo.propertyId == propertyId
      );
      // Écriture : l'un ou l'autre, max 10 Mo, audio uniquement
      allow write: if isSignedIn() && (
        firestore.get(/databases/(default)/documents/properties/$(propertyId))
          .data.landlordId == request.auth.uid ||
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid))
          .data.rentalInfo.propertyId == propertyId
      ) &&
      request.resource.size < 10 * 1024 * 1024 &&
      request.resource.contentType.matches("audio/.*");
    }

    // ── Module État des lieux — photos pièces, compteurs, PDF ──────────────
    match /properties/{propertyId}/inventory/{allPaths=**} {
      // Lecture : bailleur du logement ou locataire du logement
      allow read: if isSignedIn() && (
        firestore.get(/databases/(default)/documents/properties/$(propertyId))
          .data.landlordId == request.auth.uid ||
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid))
          .data.rentalInfo.propertyId == propertyId
      );

      // Écriture : bailleur uniquement, max 20 Mo, images ou PDF
      allow write: if isSignedIn() &&
        firestore.get(/databases/(default)/documents/properties/$(propertyId))
          .data.landlordId == request.auth.uid &&
        request.resource.size < 20 * 1024 * 1024 &&
        request.resource.contentType.matches("image/.*|application/pdf");
    }
  }
}
